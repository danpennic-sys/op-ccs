  "_note": "Abstract vectors. Config version and weights are bound into the hashed context. Each case runs Assess -> Record on a valid baseline fixture, applies 'mutation' to the recorded artifact (or call order), then runs Replay. Outcome hash re-pinned after binding config into context.",
  "cases": [
    {"name": "mutate_input_after_record",   "mutation": "mutate_input",        "expect_err": "ErrTampered"},
    {"name": "mutate_context_after_record", "mutation": "mutate_context",      "expect_err": "ErrTampered"},
    {"name": "flip_bit_in_outcome_hash",    "mutation": "flip_outcome_hash",   "expect_err": "ErrTampered"},
    {"name": "truncate_record_half",        "mutation": "truncate_half",       "expect_err": "ErrMalformedInput"},
    {"name": "drop_field_input",            "mutation": "drop_field:input",    "expect_err": "ErrMalformedInput"},
    {"name": "drop_field_context",          "mutation": "drop_field:context",  "expect_err": "ErrMalformedInput"},
    {"name": "drop_field_outcome_hash",     "mutation": "drop_field:outcome_hash", "expect_err": "ErrMalformedInput"},
    {"name": "assess_called_twice",         "mutation": "call_order:assess,assess", "expect_err": "ErrOutOfOrder"},
    {"name": "replay_after_failed_record",  "mutation": "call_order:assess,record_fail,replay", "expect_err": "ErrOutOfOrder"},
    {"name": "replay_twice_identical",      "mutation": "none", "expect_err": null, "expect_identical_runs": 2},
    {"name": "replay_matches_pinned_hash",  "mutation": "none", "expect_err": null, "expect_outcome_hash": "3eda6326acecc3fed58223aa739077384a238d1f1901606a8634cf8724071ad1"}
  ]
}
